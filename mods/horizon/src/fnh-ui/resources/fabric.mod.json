      "dev.horizonlab.fnh.FnHMenuMod"
    ]
  },
  "mixins": [
    "fnh_ui.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
